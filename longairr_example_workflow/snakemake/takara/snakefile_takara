# Corresponding config file
configfile: "config.yaml"


#-------------------------workflow settings-------------------------#

OUTPUT = config["OUTPUT"].rstrip("/") + "/"
SAMPLES = config["samples"]
LOCUS = str(config["AIRR_LOCUS"]).lower()
RUN_SEQTAG = bool(config["RUN_SEQTAG"])
AIRR_PH = bool(config["AIRR_PH"])
COPY_CONFIG = bool(config["COPY_CONFIG"])

if LOCUS not in {"ig", "tr"}:
    raise ValueError("AIRR_LOCUS must be either 'ig' or 'tr'.")

if not SAMPLES:
    raise ValueError("At least one sample must be specified in config['samples'].")

# LongAIRR writes a productive AIRR table when --ph is true and the complete
# valid AIRR table when --ph is false.
AIRR_FILENAME = (
    f"{LOCUS}_p_parse-select.tsv"
    if AIRR_PH
    else f"{LOCUS}_db-pass.tsv"
)

# All sample-level AIRR outputs must exist before the final report is created.
airr_outputs = expand(
    f"{OUTPUT}sample_demux/{{sample}}/airr/{AIRR_FILENAME}",
    sample=SAMPLES,
)

report_outputs = [
    f"{OUTPUT}summary.tsv",
    f"{OUTPUT}longairr_report.html",
]

final_outputs = report_outputs + (
    [f"{OUTPUT}config.yaml"] if COPY_CONFIG else []
)


#------------------------------rules------------------------------#

rule all:
    input:
        final_outputs


# Rule: longairr filter
rule filter:
    input:
        fastq=config["INPUT_DUPLEX_FASTQ"]
    output:
        filtered=f"{OUTPUT}filter_qc/longairr_filtered.fasta"
    params:
        minq=config["FILTER_MIN_QUAL"],
        minl=config["FILTER_MINL"],
        maxl=config["FILTER_MAXL"],
        output=OUTPUT
    log:
        f"{OUTPUT}snakemake_logs/filter.log"
    shell:
        """
        longairr filter \
            --min-qual {params.minq} \
            --minl {params.minl} \
            --maxl {params.maxl} \
            {input.fastq} \
            {params.output} \
            > {log} 2>&1
        """


# Rule: longairr demux
rule demux:
    input:
        fasta=f"{OUTPUT}filter_qc/longairr_filtered.fasta"
    output:
        split_out=expand(
            f"{OUTPUT}sample_demux/{{sample}}/split_UDI-{{sample}}.fasta",
            sample=SAMPLES,
        )
    params:
        window_length=config["DEMUX_WINDOW_LENGTH"],
        max_error=config["DEMUX_MAX_ERROR"],
        output=OUTPUT
    log:
        f"{OUTPUT}snakemake_logs/demux.log"
    shell:
        """
        longairr demux \
            --window-length {params.window_length} \
            --anchor-error {params.max_error} \
            {config[DEMUX_UID_FASTA]} \
            {input.fasta} \
            {params.output} \
            > {log} 2>&1
        """


# Rule: longairr collapse
rule collapse:
    input:
        demux_input=f"{OUTPUT}sample_demux/{{sample}}/split_UDI-{{sample}}.fasta"
    output:
        consensus=f"{OUTPUT}sample_demux/{{sample}}/collapse/4_longairr_consensus.fasta"
    params:
        demux=config["COLLAPSE_DEMUX"],
        library=config["COLLAPSE_LIBRARY"],
        window_length=config["COLLAPSE_WINDOW_LENGTH"],
        anchor_error=config["COLLAPSE_ANCHOR_ERROR"],
        umi_length=config["COLLAPSE_LENGTH"],
        minl=config["COLLAPSE_MINL"],
        maxl=config["COLLAPSE_MAXL"],
        af=config["COLLAPSE_AF"],
        gf=config["COLLAPSE_GROUP_FIELD"],
        af_min_n=config["COLLAPSE_AF_MIN_N"],
        af_bin=config["COLLAPSE_AF_BIN"],
        af_margin=config["COLLAPSE_AF_MARGIN"],
        consgap=config["COLLAPSE_CONSGAP"],
        conserr=config["COLLAPSE_CONSERROR"],
        n_subsample=config["COLLAPSE_N_SUBSAMPLE"],
        n_chunk=config["COLLAPSE_N_CHUNK"],
        seed=config["COLLAPSE_SEED"],
        output=f"{OUTPUT}sample_demux/{{sample}}/"
    threads:
        config["COLLAPSE_JOBS"]
    log:
        f"{OUTPUT}snakemake_logs/collapse_{{sample}}.log"
    shell:
        """
        longairr collapse \
            --sample {wildcards.sample} \
            --demux {params.demux} \
            --library {params.library} \
            --window-length {params.window_length} \
            --umi-length {params.umi_length} \
            --anchor-error {params.anchor_error} \
            --minl {params.minl} \
            --maxl {params.maxl} \
            --adaptive-filter {params.af} \
            --group-field {params.gf} \
            --filter-min-size {params.af_min_n} \
            --bin-size {params.af_bin} \
            --peak-margin {params.af_margin} \
            --cons-gap {params.consgap} \
            --cons-error {params.conserr} \
            --n-subsample {params.n_subsample} \
            --n-chunk {params.n_chunk} \
            --seed {params.seed} \
            --cjobs {threads} \
            {config[COLLAPSE_ANCHOR_FASTA]} \
            {input.demux_input} \
            {params.output} \
            > {log} 2>&1
        """


if RUN_SEQTAG:

    # Rule: longairr seqtag
    rule seqtag:
        input:
            consensus=f"{OUTPUT}sample_demux/{{sample}}/collapse/4_longairr_consensus.fasta"
        output:
            cpass=f"{OUTPUT}sample_demux/{{sample}}/seqtag/longairr_seqtag_primers-pass.fasta"
        params:
            split=config["SEQTAG_SPLIT"],
            window_length=config["SEQTAG_WINDOW_LENGTH"],
            anchor_error=config["SEQTAG_ANCHOR_ERROR"],
            primer_field=config["SEQTAG_PRIMER_FIELD"],
            output=f"{OUTPUT}sample_demux/{{sample}}/"
        threads:
            1
        log:
            f"{OUTPUT}snakemake_logs/seqtag_{{sample}}.log"
        shell:
            """
            longairr seqtag \
                --sample {wildcards.sample} \
                --split {params.split} \
                --window-length {params.window_length} \
                --anchor-error {params.anchor_error} \
                --pf {params.primer_field} \
                {config[SEQTAG_FASTA]} \
                {input.consensus} \
                {params.output} \
                > {log} 2>&1
            """


    # Rule: longairr airr
    rule airr:
        input:
            sequences=f"{OUTPUT}sample_demux/{{sample}}/seqtag/longairr_seqtag_primers-pass.fasta"
        output:
            airr=f"{OUTPUT}sample_demux/{{sample}}/airr/{AIRR_FILENAME}"
        params:
            prod_heavy=AIRR_PH,
            locus=LOCUS,
            igblast_dir=config["DATABASES_PARENT"] + "igblast/",
            germlines_dir=config["DATABASES_PARENT"] + "germlines/imgt/human/vdj/",
            output=f"{OUTPUT}sample_demux/{{sample}}/"
        log:
            f"{OUTPUT}snakemake_logs/airr_{{sample}}.log"
        shell:
            """
            longairr airr \
                --sample {wildcards.sample} \
                --ph {params.prod_heavy} \
                --loci {params.locus} \
                {params.igblast_dir} \
                {params.germlines_dir} \
                {input.sequences} \
                {params.output} \
                > {log} 2>&1
            """

else:
    # Rule: longairr airr without seqtag
    rule nc_airr:
        input:
            sequences=f"{OUTPUT}sample_demux/{{sample}}/collapse/4_longairr_consensus.fasta"
        output:
            airr=f"{OUTPUT}sample_demux/{{sample}}/airr/{AIRR_FILENAME}"
        params:
            prod_heavy=AIRR_PH,
            locus=LOCUS,
            igblast_dir=config["DATABASES_PARENT"] + "igblast/",
            germlines_dir=config["DATABASES_PARENT"] + "germlines/imgt/human/vdj/",
            output=f"{OUTPUT}sample_demux/{{sample}}/"
        log:
            f"{OUTPUT}snakemake_logs/airr_{{sample}}.log"
        shell:
            """
            longairr airr \
                --sample {wildcards.sample} \
                --ph {params.prod_heavy} \
                --loci {params.locus} \
                {params.igblast_dir} \
                {params.germlines_dir} \
                {input.sequences} \
                {params.output} \
                > {log} 2>&1
            """


# Rule: final LongAIRR report
rule report:
    input:
        airr_outputs
    output:
        summary=f"{OUTPUT}summary.tsv",
        html=f"{OUTPUT}longairr_report.html"
    params:
        output=OUTPUT
    log:
        f"{OUTPUT}snakemake_logs/report.log"
    shell:
        """
        longairr report {params.output} > {log} 2>&1
        """


# Rule: copy the used config.yaml to OUTPUT
rule copy_config:
    input:
        config_in=config["CONFIG_PATH"]
    output:
        config=f"{OUTPUT}config.yaml"
    shell:
        """
        cp {input.config_in} {output.config}
        """
